DATABASE_URL=postgresql+psycopg://bandwidth:bandwidth@127.0.0.1:5432/bandwidth
# Local Compose database only; replace for a shared/production deployment.
POSTGRES_PASSWORD=bandwidth
COOKIE_SECURE=false
SESSION_HOURS=8
# Optional automation token. Generate a strong random value; never commit it.
ADMIN_API_TOKEN=
# Set only for `python -m bandwidth.cli bootstrap`; otherwise prompted securely.
ADMIN_BOOTSTRAP_PASSWORD=
ACCOUNTING_SOURCE=mock
ACCOUNTING_FILE=
ISE_MODE=mock
ISE_BASE_URL=
ISE_USERNAME=
ISE_PASSWORD=
# Trusted CA bundle for the ISE appliance, if not publicly trusted. TLS is always verified.
ISE_CA_BUNDLE=
# Absolute path to an operator-reviewed deployment contract; see docs/ise.md.
ISE_CONTRACT_FILE=
ISE_TIMEOUT_SECONDS=5
WORKER_INTERVAL_SECONDS=5
ENFORCEMENT_MAX_ATTEMPTS=5
