[Unit]
Description=Bandwidth Engine accounting and enforcement worker
Requires=bandwidth-database.service
After=network-online.target bandwidth-database.service
Wants=network-online.target

[Service]
Type=simple
User=bandwidth
Group=bandwidth
WorkingDirectory=/opt/bandwidth-engine
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/bandwidth-engine/.venv/bin/python -m bandwidth.worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bandwidth-engine
UMask=0077

[Install]
WantedBy=multi-user.target
